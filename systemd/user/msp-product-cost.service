[Unit]
Description=MSP product costs (five Google CSV sources, isolated Hermes USER job)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/hermes/.local/share/msp-product-cost
EnvironmentFile=/home/hermes/.config/msp/product-costs.env
ExecStart=/usr/bin/python3 /home/hermes/.local/share/msp-product-cost/sync.py --db /opt/mcp/data/msp/msp_data.sqlite3
TimeoutStartSec=540
UMask=0077
NoNewPrivileges=true
