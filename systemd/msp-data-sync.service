[Unit]
Description=MSP data catalog synchronization
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=hermes
Group=hermes
WorkingDirectory=/opt/mcp/projects/msp-server-stack
EnvironmentFile=/opt/mcp/secrets/msp-data-alerts.env
ExecStart=/usr/bin/python3 /opt/mcp/projects/msp-server-stack/apps/msp_data_sync/run_with_alerts.py --config /opt/mcp/projects/msp-server-stack/config/msp-data/sync.json
TimeoutStartSec=420
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/mcp/data/msp

[Install]
WantedBy=multi-user.target
