[Unit]
Description=Bounded MSP finance administrative control (not a financial sender)
Requires=msp-finance-recover.service
After=msp-finance-recover.service
[Service]
Type=oneshot
User=root
ExecStart=/opt/mcp/projects/msp-marketplace-reports-releases/c1fee070e9efa0c925a78f266fdf03cb12a173cf/.venv/bin/python -I -B /opt/mcp/projects/msp-marketplace-reports-releases/control-a1807fd6995695f4e002ec5887d3bee892d9f18f86e4a1f0c92fa6e4a8b328e7/control.py
ExecStopPost=/opt/mcp/projects/msp-marketplace-reports-releases/c1fee070e9efa0c925a78f266fdf03cb12a173cf/.venv/bin/python -I -B /opt/mcp/projects/msp-marketplace-reports-releases/control-a1807fd6995695f4e002ec5887d3bee892d9f18f86e4a1f0c92fa6e4a8b328e7/control.py --close
TimeoutStartSec=1000
TimeoutStopSec=150
IPAddressDeny=any
IPAddressAllow=127.0.0.1 127.0.0.53

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
UMask=0077
Restart=no
ReadWritePaths=/var/lib/msp-finance-control /etc/msp-marketplace-reports-executor /run/systemd/system /run/msp-finance-control
