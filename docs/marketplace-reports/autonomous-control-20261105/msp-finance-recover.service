[Unit]
Description=Close owned MSP finance activation after boot; never downloads
After=local-fs.target systemd-tmpfiles-setup.service
Before=msp-finance-control.service msp-wb-pilot.service
[Service]
Type=oneshot
RemainAfterExit=yes
User=root
ExecStart=/opt/mcp/projects/msp-marketplace-reports-releases/c1fee070e9efa0c925a78f266fdf03cb12a173cf/.venv/bin/python -I -B /opt/mcp/projects/msp-marketplace-reports-releases/control-a1807fd6995695f4e002ec5887d3bee892d9f18f86e4a1f0c92fa6e4a8b328e7/control.py --recover
TimeoutStartSec=150
PrivateNetwork=yes

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
UMask=0077
Restart=no
ReadWritePaths=/var/lib/msp-finance-control /etc/msp-marketplace-reports-executor /run/systemd/system /run/msp-finance-control

[Install]
WantedBy=multi-user.target
