[Unit]
Description=Read-only MSP finance diagnostics
[Service]
Type=oneshot
User=root
ExecStart=/usr/bin/python3 -I -B /opt/mcp/projects/msp-marketplace-reports-releases/control-8dbdf9642b1d5326a363f79f6c8ec21dd3eedeac9315412093d44ed23999306d/diagnostics.py
