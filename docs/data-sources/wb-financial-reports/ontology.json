  "formulas": [
    {
      "id": "net_sales",
      "expression": "sales - returns",
      "inputs": [
        "sales",
        "returns"
      ],
      "source_ids": [
        2
      ],
      "rules": "Суммы реализации, отдельно уже агрегированные по продажам и возвратам. Входные суммы неотрицательны; не повторять знак."
    },
    {
      "id": "net_goods_payout",
      "expression": "sales - returns",
      "inputs": [
        "sales",
        "returns"
      ],
      "source_ids": [
        2
      ],
      "rules": "Суммы перечисления за товар, отдельно по продажам и возвратам; комиссия уже учтена."
    },
    {
      "id": "kvv_final",
      "expression": "base_rate - platform_discount_rate",
      "inputs": [
        "base_rate",
        "platform_discount_rate"
      ],
      "source_ids": [
        1
      ],
      "rules": "Одинаковые процентные единицы и версия отчёта."
    },
    {
      "id": "item_payout_check",
      "expression": "price * (1 - commission_rate / 100) - payment_fee",
      "inputs": [
        "price",
        "commission_rate",
        "payment_fee"
      ],
      "source_ids": [
        1
      ],
      "rules": "Проверка строки, не подмена фактического начисления. Исключения/акции/коррекции сверять отдельно; округление согласно версии отчёта."
    },
    {
      "id": "settlement_core",
      "expression": "goods_net - delivery - storage - processing - penalties - loyalty_fee_net - loyalty_points_net - deductions_signed + loyalty_compensation",
      "inputs": [
        "goods_net",
        "delivery",
        "storage",
        "processing",
        "penalties",
        "loyalty_fee_net",
        "loyalty_points_net",
        "deductions_signed",
        "loyalty_compensation"
      ],
      "source_ids": [
        2
      ],
      "rules": "Базовая опубликованная сверка. deductions_signed: плюс удержание, минус выплата. Дополнительные корректировки/плата за ускорение требуют явного подтверждения включения; неизвестная составляющая означает неполную сверку, не ноль."
