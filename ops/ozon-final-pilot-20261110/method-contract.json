            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/rpcStatus"
              }
            }
          }
        },
        "403": {
          "description": "Access denied",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/rpcStatus"
              }
            }
          }
        },
        "404": {
          "description": "Response not found",
