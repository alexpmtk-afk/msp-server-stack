            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/rpcStatus"
              }
            }
          }
        },
        "409": {
          "description": "Request conflict",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/rpcStatus"
              }
            }
          }
        },
        "500": {
          "description": "Internal server error",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/rpcStatus"
              }
            }
          }
        }
      },
      "tags": [
