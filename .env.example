# SAFE TEMPLATE ONLY.
# Copy this file to a protected server-side .env and fill values there.
# Never commit the populated file.

MSP_ENV=production
MSP_ROOT=/opt/mcp

# External AI provider
OPENAI_API_KEY=<SET_ON_SERVER_ONLY>

# Telegram
TELEGRAM_BOT_TOKEN=<SET_ON_SERVER_ONLY>
TELEGRAM_API_ID=<SET_ON_SERVER_ONLY>
TELEGRAM_API_HASH=<SET_ON_SERVER_ONLY>

# Network / tunnel / proxy credentials if required
TUNNEL_AUTH_TOKEN=<SET_ON_SERVER_ONLY>
PROXY_URL=<SET_ON_SERVER_ONLY>

# Application data sources
DATABASE_URL=<SET_ON_SERVER_ONLY>

# Andrey / QRsite integration
ANDREY_API_TOKEN=<SET_ON_SERVER_ONLY>
ANDREY_MCP_TOKEN=<SET_ON_SERVER_ONLY>
