+def test_commentary_cannot_be_a_terminal_response():
+    result = CodexEventProjector().project({
+        "method": "item/completed",
+        "params": {"item": {"type": "agentMessage", "id": "progress",
+                             "text": "Checking API", "phase": "commentary"}},
