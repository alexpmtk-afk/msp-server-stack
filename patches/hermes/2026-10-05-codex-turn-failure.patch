diff --git a/tests/agent/transports/test_codex_app_server_session.py b/tests/agent/transports/test_codex_app_server_session.py
index fc5a96303..a3ebc10a5 100644
--- a/tests/agent/transports/test_codex_app_server_session.py
+++ b/tests/agent/transports/test_codex_app_server_session.py
@@ -1160,3 +1160,16 @@ def test_only_current_turn_progress_reaches_hermes_activity_clock():
     assert result.error is None and not result.interrupted
     assert agent._turn_liveness_activity_generation == generation + 1
     assert agent._last_activity_desc == "codex app-server: item/agentMessage/delta"
+
+
+def test_overload_after_commentary_is_error_not_success():
+    client = FakeClient()
+    client.queue_notification("item/completed", threadId="t", turnId="turn-fake-001",
+        item={"type": "agentMessage", "id": "progress", "text": "Checking API", "phase": "commentary"})
+    client.queue_notification("turn/completed", threadId="t",
+        turn={"id": "turn-fake-001", "status": "failed",
+              "error": {"message": "Selected model is at capacity. Please try a different model.",
+                        "codexErrorInfo": "serverOverloaded"}})
+    result = make_session(client).run_turn("audit", turn_timeout=2.0)
+    assert result.error and "capacity" in result.error
+    assert not result.final_text
