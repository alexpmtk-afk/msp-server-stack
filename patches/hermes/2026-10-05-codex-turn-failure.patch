+    assert result.messages[0]["content"] == "Checking API"
+    assert result.final_text is None
diff --git a/tests/agent/test_codex_runtime_failure_result.py b/tests/agent/test_codex_runtime_failure_result.py
new file mode 100644
index 000000000..52201910d
--- /dev/null
+++ b/tests/agent/test_codex_runtime_failure_result.py
@@ -0,0 +1,11 @@
+from agent.codex_runtime import _turn_result
+
+def test_provider_error_is_marked_failed_for_gateway_delivery():
+    result = _turn_result((False, None), [], api_calls=1, completed=False,
+                          error="server_overloaded", final_response="")
+    assert result["failed"] is True
+
+def test_user_interruption_is_not_failure():
+    result = _turn_result((True, "stop"), [], api_calls=1, completed=False,
+                          error="interrupted", final_response="")
+    assert result["failed"] is False
